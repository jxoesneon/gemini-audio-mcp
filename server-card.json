{
  "serverInfo": {
    "name": "Gemini Audio MCP",
    "version": "0.1.0"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "GEMINI_API_KEY": {
        "type": "string",
        "description": "Your Google AI Studio API Key",
        "x-from": "env"
      }
    },
    "required": ["GEMINI_API_KEY"]
  },
  "tools": [
    {
      "name": "generate_soundscape",
      "description": "Generates immersive, high-quality environmental soundscapes. (PAID MODELS).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string", "description": "Description of the soundscape" },
          "duration": { "type": "integer", "description": "Target duration in seconds" },
          "quality": { "type": "string", "enum": ["mid", "high"] },
          "bpm": { "type": "number" },
          "song_key": { "type": "string" },
          "intensity": { "type": "number" },
          "seed": { "type": "integer" }
        },
        "required": ["prompt"]
      }
    },
    {
      "name": "generate_voice",
      "description": "Convert text to expressive speech with natural voice direction using Gemini 2.5 Native Audio.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "description": "Text to speak" },
          "voice_direction": { "type": "string", "description": "Style/tone instructions" }
        },
        "required": ["text"]
      }
    },
    {
      "name": "generate_music",
      "description": "Generate high-fidelity musical compositions via Lyria 3 Pro/Clip.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string", "description": "Musical style and description" },
          "lyrics": { "type": "string" },
          "quality": { "type": "string", "enum": ["mid", "high"] },
          "bpm": { "type": "number" },
          "song_key": { "type": "string" },
          "intensity": { "type": "number" },
          "candidate_count": { "type": "integer" }
        },
        "required": ["prompt"]
      }
    },
    {
      "name": "generate_sfx",
      "description": "Create isolated sound effects and foley cues using Lyria Clip.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string", "description": "Description of the sound effect" }
        },
        "required": ["prompt"]
      }
    },
    {
      "name": "transition_soundscape",
      "description": "Seamlessly crossfade between two distinct audio environments.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from_prompt": { "type": "string" },
          "to_prompt": { "type": "string" },
          "transition_duration": { "type": "integer" }
        },
        "required": ["from_prompt", "to_prompt"]
      }
    },
    {
      "name": "list_models",
      "description": "List available audio generation models and engines.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "generate_custom",
      "description": "Advanced tool for full control over audio generation parameters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string" },
          "engine": { "type": "string", "enum": ["lyria", "gemini-live"] },
          "model": { "type": "string" },
          "seed": { "type": "integer" },
          "negative_prompt": { "type": "string" },
          "bpm": { "type": "number" },
          "intensity": { "type": "number" }
        },
        "required": ["prompt", "engine"]
      }
    }
  ],
  "resources": [],
  "prompts": []
}
